# O app (gunicorn), sem reaproveitar conexões: com keep-alive o Caddy às
# vezes escrevia um POST numa conexão que o gunicorn tinha acabado de fechar
# (o keep-alive dele é de 2 s), e um POST não é reenviado - virava 502. Era
# assim que lotes do Stream ao vivo (/spectate/ingest) se perdiam e quem
# acompanhava a partida dessincronizava.
(gunicorn) {
    reverse_proxy 127.0.0.1:8000 {
        transport http {
            keepalive off
        }
    }
}

# Pacote do atualizador do RetroArch TIERES (manifesto + arquivos pelo
# sha256, deploy/publish_pacote.sh): servido direto da pasta, sem passar pelo
# gunicorn - são uns 25 MB por jogador, e o app só tem 2 threads.
(pacote_tieres) {
    handle /updates/pacote/* {
        uri strip_prefix /updates/pacote
        root * /var/www/arena17/pacote
        @manifesto path *.txt
        header @manifesto Cache-Control "no-cache"
        file_server
    }
}

we2002.wgs.dev.br {
    import pacote_tieres
    handle {
        import gunicorn
    }
}

# Plain HTTP listener for the kaillera-client endpoints (ingest from the
# hosting client, lookup/stream for live spectators, replays list/download
# for the "Replays Online" playback screen). The client speaks unencrypted
# HTTP, not HTTPS, so this can't go through the main HTTPS site above.
# Scoped to only these paths; everything else 404s.
http://:8080 {
    handle /spectate/ingest {
        import gunicorn
    }
    handle /spectate/lookup {
        import gunicorn
    }
    handle /spectate/stream/* {
        import gunicorn
    }
    # "Ir direto para o Ao Vivo!" (Watch Live toolbar) - state hand-off
    # between a spectator and the host, per session id.
    handle /spectate/*/state-request {
        import gunicorn
    }
    handle /spectate/*/state {
        import gunicorn
    }
    handle /replays/* {
        import gunicorn
    }
    # O DLL rodando no Wine baixa o pacote por aqui (o HTTPS do Wine trava em
    # algumas versões).
    import pacote_tieres
    handle /updates/* {
        import gunicorn
    }
    handle {
        respond 404
    }
}
