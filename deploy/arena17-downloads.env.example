ARENA17_SECRET_KEY=gere-um-segredo-longo-e-aleatorio-aqui
ARENA17_INSTANCE_PATH=/opt/arena17-downloads/instance
ARENA17_DOWNLOADS_DIR=/var/www/arena17/downloads
ARENA17_UPLOAD_TMP_DIR=/var/www/arena17/uploads-tmp
ARENA17_MAX_UPLOAD_BYTES=8589934592
# Mantenha ausente ou false em produção. Apenas para teste sem Nginx:
# ARENA17_SERVE_DOWNLOADS_LOCALLY=true
ARENA17_LIVE_DIR=/var/www/arena17/live
ARENA17_SPECTATE_KEY=gere-outra-chave-longa-e-aleatoria-aqui
# Memory Card online: cartões dos jogadores (fora do diretório público).
ARENA17_MEMCARDS_DIR=/var/www/arena17/memcards
# Base dos links de confirmação de cadastro / nova senha enviados por e-mail.
ARENA17_PUBLIC_URL=https://we2002.wgs.dev.br
# SMTP para os e-mails de cadastro (sem ARENA17_SMTP_HOST, os e-mails são
# só gravados em instance/outbox/). ARENA17_SMTP_SECURITY: starttls (587),
# ssl (465) ou none.
ARENA17_SMTP_HOST=smtp.exemplo.com
ARENA17_SMTP_PORT=587
ARENA17_SMTP_SECURITY=starttls
ARENA17_SMTP_USER=nao-responda@wgs.dev.br
ARENA17_SMTP_PASSWORD=senha-do-smtp
ARENA17_MAIL_FROM=WE Camp <nao-responda@wgs.dev.br>
# Discord da WE Camp (canal de voz por partida + "Vincular Discord" na conta).
# Segredos: token do bot (Developer Portal > Bot > Reset Token) e Client
# Secret (OAuth2). Os IDs do servidor/categoria/canal já são o padrão no código.
ARENA17_DISCORD_BOT_TOKEN=
ARENA17_DISCORD_CLIENT_SECRET=
