[Unit]
Description=Arena17 Downloads (Flask/Gunicorn)
After=network.target

[Service]
Type=exec
User=arena17
# O socket fica acessível ao worker Nginx sem expor o Gunicorn na rede.
Group=arena17
WorkingDirectory=/opt/arena17-downloads
EnvironmentFile=/etc/arena17-downloads.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/arena17-downloads/vendor
ExecStart=/usr/bin/python3 -m gunicorn --workers 1 --threads 2 --worker-tmp-dir /dev/shm --bind 127.0.0.1:8000 wsgi:app
RuntimeDirectory=arena17-downloads
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arena17-downloads/instance /var/www/arena17

[Install]
WantedBy=multi-user.target
